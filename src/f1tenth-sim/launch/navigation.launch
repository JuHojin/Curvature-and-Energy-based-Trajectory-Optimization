<launch>
    <!-- Move Base -->
    <node name="move_base" pkg="move_base" type="move_base" respawn="false" output="screen">
        <rosparam file="$(find f1tenth-sim)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find f1tenth-sim)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find f1tenth-sim)/config/global_costmap_params.yaml" command="load" ns="global_costmap"/>
        <rosparam file="$(find f1tenth-sim)/config/local_costmap_params.yaml" command="load" ns="local_costmap"/>
        <rosparam file="$(find f1tenth-sim)/config/move_base_params.yaml" command="load"/>
    </node>
</launch>
